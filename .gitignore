# ---- Java / Maven ----
target/
*.class
*.jar
!**/maven-wrapper.jar
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Lo genera uv al instalar, pero nadie lo lee: los Dockerfiles y CI instalan
# desde pyproject.toml. Commitearlo daria una falsa sensacion de build
# reproducible. Ver el ADR de dependencias de Python.
uv.lock
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Flutter / Dart ----
client/.dart_tool/
client/.flutter-plugins
client/.flutter-plugins-dependencies
client/build/
client/ios/Pods/
client/ios/.symlinks/
client/android/.gradle/
client/android/.kotlin/
# Registros de caida de la JVM de Gradle (falta de memoria al compilar).
client/android/hs_err_pid*.log
client/android/replay_pid*.log
client/android/local.properties
client/.packages
*.iml

# Modelos on-device: pesan demasiado para git, se bajan aparte
client/assets/models/*
!client/assets/models/README.md

# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# ---- Configuracion personal de agentes ----
# El settings.json del proyecto SI se commitea: son las reglas del equipo.
# Este es el de cada uno, para relajarse las suyas sin imponerselo al resto.
.claude/settings.local.json

# ---- Entorno / secretos ----
.env
.env.local
*.pem
*.key

# ---- Editores / SO ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- Datos locales de contenedores ----
.data/

# ---- Calibracion de colorimetria: nada de esto va al repositorio ----
# Fotos de personas (docs/politica-datos-colorimetria-wearhack.md, seccion 12).
# Es una red de seguridad contra un `git add` por descuido, no la defensa: la
# defensa es que la app y el script se nieguen a escribir dentro de un repo.
lote_*.zip
*_foto.jpg
*_foto.heic
*_recorte.png
