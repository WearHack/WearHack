# Copia este archivo a .env antes de levantar el entorno local:
#   cp .env.example .env
# .env esta en .gitignore. Nunca lo commitees.

# ---------------------------------------------------------------- puertos ---
# El gateway es el unico que expone al exterior. Los demas se publican en
# local solo para poder depurarlos sueltos.
GATEWAY_PORT=8080
USUARIOS_PORT=8081
CLOSET_PORT=8082
OUTFITS_PORT=8083
PUBLICIDAD_PORT=8084
COLORIMETRIA_PORT=8091
RECOMENDADOR_PORT=8092
# El Core: un solo deployable. Sustituye a los cuatro servicios Java y al gateway.
CORE_PORT=8090

# ----------------------------------------------------------------- mongodb ---
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=wearhack
MONGO_INITDB_ROOT_PASSWORD=wearhack_local_dev
MONGO_DB=wearhack
# Cadena que usan los servicios dentro de la red de compose
MONGO_URI=mongodb://wearhack:wearhack_local_dev@mongo:27017/wearhack?authSource=admin

# --------------------------------------------------------- mongodb atlas ---
# Un usuario de Atlas por componente (infra/datos/README.md). Vacias: cada
# servicio usa MONGO_URI. Cada URI lleva la base en la ruta: .../wearhack?...
# MONGODB_DB solo lo leen los scripts de infra/datos/.
MONGODB_DB=wearhack
MONGODB_URI_CORE=
MONGODB_URI_COLORIMETRIA=
MONGODB_URI_RECOMENDACION=
MONGODB_URI_JOBS=

# --------------------------------------------------------- cognito (Core) ---
# El User Pool que emite los tokens. Vacio: el Core rechaza todo token y solo
# responde /health. No son secretos (van dentro de la app movil), pero cada
# quien usa los de su Learner Lab. Ver infra/cognito/README.md.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
# App clients aceptados, separados por coma.
COGNITO_CLIENT_IDS=

# ---------------------------------------------------- object storage (S3) ---
# En AWS esto es S3. En local, Adobe S3Mock habla el mismo protocolo.
S3_ENDPOINT=http://s3:9090
S3_REGION=us-east-1
S3_ACCESS_KEY=wearhack
S3_SECRET_KEY=wearhack_local_dev
S3_BUCKET_PRENDAS=wearhack-prendas
S3_BUCKET_ROSTROS=wearhack-rostros
S3_PORT=9000
# Con el que el telefono abre las URLs firmadas de las imagenes de prendas.
# Emulador de Android: http://10.0.2.2:9000. Telefono fisico: la IP del equipo.
S3_ENDPOINT_PUBLICO=http://localhost:9000

# ----------------------------------------------------------- observabilidad ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318

# ------------------------------------------------------------------ entorno ---
ENVIRONMENT=local
LOG_LEVEL=INFO
