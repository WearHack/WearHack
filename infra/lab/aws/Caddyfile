{$DOMINIO} {
	encode gzip

	# Trazabilidad: la pagina (fuera del repo, en /opt/wearhack/trazabilidad) y la API de
	# consulta de Jaeger, las dos con usuario y clave (SSM /wearhack/TRAZABILIDAD_*).
	redir /trazabilidad /trazabilidad/
	handle /trazabilidad/* {
		basic_auth {
			{$TRAZABILIDAD_USUARIO} {$TRAZABILIDAD_HASH}
		}
		handle_path /trazabilidad/api/* {
			# Jaeger 2.22 solo trae la API v3 (/api/v3). Bajo /jaeger/api responde su
			# propia interfaz web, no JSON.
			rewrite * /api/v3{uri}
			reverse_proxy jaeger:16686
		}
		handle {
			uri strip_prefix /trazabilidad
			root * /srv/trazabilidad
			file_server
		}
	}

	handle {
		reverse_proxy core:8090
	}
}
