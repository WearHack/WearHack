# Copia este archivo a ".env" y completa los valores.
# NUNCA subas ".env" al repositorio (debe estar en .gitignore).
#
# Una URI por componente: cada una usa un usuario distinto de Atlas (ver README.md).
# Formato: mongodb+srv://USUARIO:CONTRASENA@TU-CLUSTER.mongodb.net/
# La contraseña: larga y solo con letras y números (los símbolos rompen la URI).
# Cada persona recibe en privado SOLO la URI del componente que usa.

MONGODB_DB=wearhack

MONGODB_URI_CORE=
MONGODB_URI_COLORIMETRIA=
MONGODB_URI_RECOMENDACION=
MONGODB_URI_JOBS=
